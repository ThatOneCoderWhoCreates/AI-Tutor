# Copy this file to .env (same folder). Never commit .env to GitHub.

# ---- Language model: the ONLY place to switch models ----
# ollama = local model through Ollama (run "ollama pull qwen2.5:7b" first)
# mock   = offline fake model, nothing to install (good for UI work and tests)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192
LLM_TIMEOUT=300
# off = skip the thinking step of models like qwen3.5 (much faster), on = let them think
LLM_THINK=off

# ---- Answers for questions the lectures do not cover ----
# The reply starts with "[It was not covered in this lecture, but this is the answer to your question]".
# Only the question and recent chat messages are sent, never the lecture text.
# List models in the order to try them. If one hits its free limit or fails, the next one answers.
#   gemini      free key from https://aistudio.google.com/apikey (recommended first choice)
#   groq        free key from https://console.groq.com/keys (very fast)
#   openrouter  free key from https://openrouter.ai/keys, write it as openrouter:<free model name>
#   local       the local Ollama model, no key, always available (weaker answers), good last choice
#   none        off
# "provider:model" picks a model, for example gemini:gemini-3.8-flash. Leave a key empty to skip that service.
FALLBACK_PROVIDER=gemini,groq,local
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Search ----
# sentence-transformers downloads BAAI/bge-small-en-v1.5 (about 130 MB) on first run
# hash = offline fallback with no download, much weaker search
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE=chroma
TOP_K=4

# ---- Video ingestion ----
# mlx = fast on Apple-silicon Macs, faster = faster-whisper, works on any CPU
WHISPER_BACKEND=mlx
WHISPER_MODEL=small
SCENE_THRESHOLD=0.01
MAX_CHUNK_SECONDS=90

CORS_ORIGINS=http://localhost:5173
